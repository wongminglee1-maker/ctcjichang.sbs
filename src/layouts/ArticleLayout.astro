---
import BaseLayout from './BaseLayout.astro';
import { brandData } from '../data/brand';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  category: string;
  readTime: string;
  keywords: string[];
  slug: string;
}

const {
  title,
  description,
  publishDate,
  category,
  readTime,
  keywords,
  slug
} = Astro.props;

const canonicalUrl = `https://ctcjichang.sbs/guides/${slug}/`;

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${canonicalUrl}#article`,
      "isPartOf": {
        "@type": "WebPage",
        "@id": canonicalUrl,
        "url": canonicalUrl,
        "name": title
      },
      "headline": title,
      "description": description,
      "datePublished": `${publishDate}T08:00:00+08:00`,
      "dateModified": `${publishDate}T08:00:00+08:00`,
      "inLanguage": "zh-CN",
      "keywords": keywords.join(','),
      "author": {
        "@type": "Organization",
        "name": "CTC 网络自检实验室",
        "url": "https://ctcjichang.sbs/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "CTC 金龙鱼官网",
        "url": "https://ctcjichang.sbs/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首页",
          "item": "https://ctcjichang.sbs/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "使用指南",
          "item": "https://ctcjichang.sbs/guides/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={`${title}｜CTC 金龙鱼指南`}
  description={description}
  canonicalUrl={canonicalUrl}
  ogType="article"
  schemaData={articleSchema}
>
  <div class="article-page-wrapper">
    <div class="container article-container">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb-nav" aria-label="面包屑导航">
        <ol>
          <li><a href="/">首页</a></li>
          <li><span>/</span></li>
          <li><a href="/guides/">使用指南</a></li>
          <li><span>/</span></li>
          <li aria-current="page">{category}</li>
        </ol>
      </nav>

      <article class="main-article-content">
        <!-- Article Header -->
        <header class="article-header">
          <div class="article-meta-top">
            <span class="badge badge-ice">{category}</span>
            <span class="meta-separator">•</span>
            <time datetime={publishDate}>{publishDate}</time>
            <span class="meta-separator">•</span>
            <span>预计阅读 {readTime}</span>
          </div>
          <h1>{title}</h1>
          <p class="article-lead">{description}</p>
        </header>

        <!-- Markdown Body -->
        <div class="markdown-body">
          <slot />
        </div>

        <!-- Article Footer & Quick Action Banner -->
        <footer class="article-footer-box">
          <div class="article-tags-list">
            <span class="tags-label">核心主题词：</span>
            {keywords.map((kw) => (
              <span class="article-tag">#{kw}</span>
            ))}
          </div>

          <div class="diagnostic-cta-banner">
            <div>
              <h4>遇到类似的连接故障？</h4>
              <p>使用 CTC 互动自检中心，按步骤排查并生成去敏自检报告。</p>
            </div>
            <div class="cta-btns">
              <a href="/diagnostics/" class="btn btn-primary">进入网络自检中心</a>
              <a href={brandData.registerUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">访问开通通道</a>
            </div>
          </div>
        </footer>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .article-page-wrapper {
    padding: 30px 0 80px 0;
  }

  .article-container {
    max-width: 860px;
  }

  .breadcrumb-nav {
    margin-bottom: 24px;
    font-size: 0.88rem;
  }

  .breadcrumb-nav ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .breadcrumb-nav a {
    color: var(--color-secondary-text);
  }

  .breadcrumb-nav a:hover {
    color: var(--color-button-blue);
  }

  .breadcrumb-nav span {
    color: var(--color-border);
  }

  .breadcrumb-nav li[aria-current="page"] {
    color: var(--color-deep-blue);
    font-weight: 600;
  }

  .main-article-content {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 50px 48px;
    box-shadow: var(--shadow-sm);
  }

  .article-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 30px;
    margin-bottom: 36px;
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--color-secondary-text);
    margin-bottom: 16px;
  }

  .meta-separator {
    color: var(--color-border);
  }

  .article-header h1 {
    font-size: 2.2rem;
    line-height: 1.3;
    color: var(--color-deep-blue);
    margin-bottom: 16px;
  }

  .article-lead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-secondary-text);
  }

  /* Markdown body typography */
  .markdown-body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-primary-text);
  }

  .markdown-body h2 {
    font-size: 1.6rem;
    margin: 44px 0 18px 0;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-ice-blue);
    color: var(--color-deep-blue);
  }

  .markdown-body h3 {
    font-size: 1.25rem;
    margin: 30px 0 14px 0;
    color: var(--color-deep-blue);
  }

  .markdown-body p {
    margin-bottom: 20px;
  }

  .markdown-body ul, .markdown-body ol {
    margin: 16px 0 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .markdown-body li {
    line-height: 1.7;
  }

  .markdown-body blockquote {
    background-color: var(--color-surface-muted);
    border-left: 4px solid var(--color-button-blue);
    padding: 16px 20px;
    margin: 24px 0;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.98rem;
    color: #1e3a66;
  }

  .markdown-body pre {
    background-color: #0F172A;
    color: #F8FAFC;
    padding: 20px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 24px 0;
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }

  .markdown-body code {
    background-color: #E2E8F0;
    color: var(--color-deep-blue);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: var(--font-mono);
  }

  .markdown-body pre code {
    background: transparent;
    color: inherit;
    padding: 0;
  }

  .markdown-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 0.92rem;
  }

  .markdown-body th, .markdown-body td {
    border: 1px solid var(--color-border);
    padding: 12px 16px;
    text-align: left;
  }

  .markdown-body th {
    background-color: var(--color-surface-muted);
    color: var(--color-deep-blue);
    font-weight: 700;
  }

  .markdown-body tr:nth-child(even) {
    background-color: #FAFCFF;
  }

  .markdown-body hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 36px 0;
  }

  /* Article Footer Box */
  .article-footer-box {
    margin-top: 50px;
    border-top: 1px solid var(--color-border);
    padding-top: 30px;
  }

  .article-tags-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 30px;
  }

  .tags-label {
    font-size: 0.85rem;
    color: var(--color-secondary-text);
  }

  .article-tag {
    background-color: var(--color-surface-muted);
    color: var(--color-deep-blue);
    font-size: 0.8rem;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
  }

  .diagnostic-cta-banner {
    background: linear-gradient(135deg, #122B5B 0%, #1c3d7d 100%);
    color: #FFFFFF;
    border-radius: var(--radius-lg);
    padding: 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .diagnostic-cta-banner h4 {
    color: #FFFFFF;
    font-size: 1.25rem;
    margin-bottom: 6px;
  }

  .diagnostic-cta-banner p {
    color: #C5DFFF;
    font-size: 0.9rem;
  }

  .cta-btns {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .main-article-content {
      padding: 30px 20px;
    }
    .article-header h1 {
      font-size: 1.7rem;
    }
    .diagnostic-cta-banner {
      flex-direction: column;
      align-items: flex-start;
    }
    .cta-btns {
      width: 100%;
      flex-direction: column;
    }
    .cta-btns a {
      width: 100%;
      text-align: center;
    }
  }
</style>
