---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingBento from '../components/PricingBento.astro';
import { brandData } from '../data/brand';
import { sourceRegistry } from '../data/sources';

const pageTitle = "CTC 金龙鱼套餐价格核验与订购指南｜CTC机场资费标准";
const pageDescription = "查阅 CTC 金龙鱼机场 SE-100G、SE-360G、SE-800G 等套餐基准参数，了解邀请码机制、邮箱白名单及实时订购开通注意事项。";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://ctcjichang.sbs/pricing/"
>
  <div class="pricing-page-header">
    <div class="container text-center">
      <span class="badge badge-ice mb-3">资费公开与透明度声明</span>
      <h1>CTC 金龙鱼套餐与开通核验</h1>
      <p class="lead-text">
        本页面汇集公开归档的历史套餐基准。由于机场运营方会根据服务器带宽与专线成本动态调整现行资费，所有即时价格均标为【待核实】，请以实际订购通道为准。
      </p>
    </div>
  </div>

  <PricingBento />

  <!-- Verification Sources & Transparency Section -->
  <section class="sources-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-purple section-tag">数据源溯源记录</span>
        <h2>资费与服务核验日志</h2>
        <p>我们对所有公开端点及归档进行实测核对，确保不虚构任何商业信息。</p>
      </div>

      <div class="sources-table-card">
        <table class="sources-table">
          <thead>
            <tr>
              <th>核验目标</th>
              <th>核查端点 / 来源</th>
              <th>实测状态</th>
              <th>核查结论摘要</th>
            </tr>
          </thead>
          <tbody>
            {sourceRegistry.map((item) => (
              <tr>
                <td><strong>{item.sourceName}</strong></td>
                <td><code class="endpoint-code">{item.sourceUrl}</code></td>
                <td>
                  <span class:list={['badge', item.status === 'verified' ? 'badge-green' : 'badge-ice']}>
                    {item.status === 'verified' ? '接口实测' : (item.status === 'active_target' ? '直达目标' : '历史归档')}
                  </span>
                </td>
                <td>
                  <ul class="source-items-list">
                    {item.verifiedItems.map((v) => (
                      <li>{v}</li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="invite-notice-card">
        <div class="invite-icon">🔑</div>
        <div>
          <h4>关于注册邀请码 (Invite Code) 的重要说明</h4>
          <p>
            经本站对 CTC 官方接口的实测调用确认，注册系统当前严格启用了邀请制校验（<code>is_invite_force: 1</code>）。未经邀请码直接访问注册页面可能无法完成账号激活。通过本站提供的专属注册通道进入已预填有效授权邀请凭据。
          </p>
          <div class="mt-4">
            <a href={brandData.registerUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              前往官方邀请注册通道 →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pricing-page-header {
    padding: 50px 0 20px 0;
  }

  .text-center { text-align: center; }
  .mb-3 { margin-bottom: 12px; }
  .mt-4 { margin-top: 16px; }

  .pricing-page-header h1 {
    font-size: 2.4rem;
    color: var(--color-deep-blue);
    margin-bottom: 16px;
  }

  .lead-text {
    max-width: 760px;
    margin: 0 auto;
    color: var(--color-secondary-text);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .sources-section {
    padding: 60px 0 80px 0;
  }

  .sources-table-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow-x: auto;
    box-shadow: var(--shadow-sm);
    margin-bottom: 30px;
  }

  .sources-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .sources-table th, .sources-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .sources-table th {
    background-color: var(--color-surface-muted);
    color: var(--color-deep-blue);
    font-weight: 700;
  }

  .endpoint-code {
    background-color: var(--color-surface-muted);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.78rem;
    word-break: break-all;
  }

  .source-items-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .source-items-list li {
    font-size: 0.85rem;
    color: var(--color-primary-text);
  }

  .source-items-list li::before {
    content: "• ";
    color: var(--color-button-blue);
  }

  .invite-notice-card {
    background: linear-gradient(135deg, #FFFFFF 0%, #F0F6FF 100%);
    border: 1px solid #bfdbfe;
    border-radius: var(--radius-xl);
    padding: 30px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .invite-icon {
    font-size: 2.4rem;
    flex-shrink: 0;
  }

  .invite-notice-card h4 {
    font-size: 1.25rem;
    color: var(--color-deep-blue);
    margin-bottom: 8px;
  }

  .invite-notice-card p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-primary-text);
  }

  @media (max-width: 640px) {
    .pricing-page-header h1 {
      font-size: 1.8rem;
    }
    .invite-notice-card {
      flex-direction: column;
    }
  }
</style>
