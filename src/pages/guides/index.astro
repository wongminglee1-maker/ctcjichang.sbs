---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleGrid from '../../components/ArticleGrid.astro';

const pageTitle = "CTC 金龙鱼使用指南与知识库｜Windows/安卓/iOS/校园网连接排错";
const pageDescription = "汇集六篇针对性原创网络排错长文，深入解析 Wi-Fi 与移动流量切换、Windows 11 系统代理冲突、安卓后台保活及校园网强制认证。";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://ctcjichang.sbs/guides/"
>
  <div class="guides-index-header">
    <div class="container text-center">
      <span class="badge badge-ice mb-3">原创技术智库</span>
      <h1>CTC 原创连接与网络排错指南</h1>
      <p class="lead-text">
        告别泛泛而谈的模板化教程。我们为每一类具体操作系统与网络拓扑编写了详实的排错依据与图文对照，帮助你彻底理清节点连接逻辑。
      </p>
    </div>
  </div>

  <ArticleGrid showSearch={true} />
</BaseLayout>

<style>
  .guides-index-header {
    padding: 60px 0 20px 0;
  }

  .text-center { text-align: center; }
  .mb-3 { margin-bottom: 12px; }

  .guides-index-header h1 {
    font-size: 2.4rem;
    color: var(--color-deep-blue);
    margin-bottom: 16px;
  }

  .lead-text {
    max-width: 740px;
    margin: 0 auto;
    color: var(--color-secondary-text);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .guides-index-header h1 {
      font-size: 1.8rem;
    }
  }
</style>
