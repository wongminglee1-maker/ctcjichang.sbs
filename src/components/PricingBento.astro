---
import { pricingPlans } from '../data/pricing';
import { brandData } from '../data/brand';
---

<section id="pricing" class="pricing-section">
  <div class="container">
    <div class="section-header bento-reveal">
      <span class="badge badge-ice section-tag">资费与配置基准</span>
      <h2>CTC 订阅套餐与开通核验</h2>
      <p>恪守技术真实性原则，基准数据源自公开历史归档，所有实时售价与库存以订购页面为准。</p>
    </div>

    <!-- Asymmetric Bento Pricing Cards -->
    <div class="pricing-bento-grid">
      {pricingPlans.map((plan, index) => (
        <div class:list={[
          'pricing-card',
          'bento-reveal',
          `delay-${index + 1}`,
          plan.highlight ? 'col-span-6 featured' : 'col-span-3'
        ]}>
          <div class="pricing-badge-top">
            <span class:list={['badge', plan.highlight ? 'badge-purple' : 'badge-ice']}>
              {plan.statusText}
            </span>
          </div>

          <div class="plan-header">
            <h3>{plan.name}</h3>
            <span class="plan-subtitle">{plan.subtitle}</span>
          </div>

          <div class="price-box">
            <span class="amount">{plan.price}</span>
            <span class="cycle">/ {plan.billingCycle}</span>
          </div>

          <div class="traffic-tag">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"></path>
            </svg>
            <span>{plan.trafficMonthly}</span>
          </div>

          <ul class="price-features">
            {plan.features.map((feature) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <div class="plan-footer">
            <p class="plan-note">{plan.notes}</p>
            <a 
              href={brandData.registerUrl} 
              class:list={['btn', plan.highlight ? 'btn-primary' : 'btn-secondary', 'w-full']}
              target="_blank" 
              rel="noopener noreferrer"
            >
              前往订购 / 注册通道 →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .mb-6 { margin-bottom: 28px; }
  .w-full { width: 100%; }

  .warning-icon {
    flex-shrink: 0;
    color: var(--color-warning-text);
    margin-top: 2px;
  }

  .plan-header h3 {
    font-size: 1.5rem;
    color: var(--color-deep-blue);
    margin-bottom: 4px;
  }

  .plan-subtitle {
    font-size: 0.85rem;
    color: var(--color-secondary-text);
  }

  .traffic-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-surface-muted);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-deep-blue);
    margin-bottom: 18px;
  }

  .plan-footer {
    margin-top: auto;
  }

  .plan-note {
    font-size: 0.8rem;
    color: var(--color-secondary-text);
    margin-bottom: 14px;
    line-height: 1.4;
  }
</style>
