---
import { networkRoutes, regionNodes, protocolInfo } from '../data/network';
---

<section id="network" class="network-section">
  <div class="container">
    <div class="section-header bento-reveal">
      <span class="badge badge-ice section-tag">网络拓扑深度拆解</span>
      <h2>CTC 线路架构与节点覆盖</h2>
      <p>清晰区分直连、中转与 IEPL 专线原理，杜绝虚假低延迟宣传，掌握真实网络传输逻辑。</p>
    </div>

    <!-- Three Network Architecture Cards -->
    <div class="network-grid">
      {networkRoutes.map((route, index) => (
        <div class={`network-card bento-reveal delay-${index + 1}`}>
          <div class="feature-card-header">
            <span class="badge badge-purple">{route.badge}</span>
            <span class="text-xs text-muted">{route.verificationStatus}</span>
          </div>
          <h3>{route.name}</h3>
          <p class="route-principle">{route.principle}</p>
          
          <div class="scenario-box">
            <strong>适用场景：</strong>
            <span>{route.scenario}</span>
          </div>

          <div class="stability-box">
            <strong>稳定性特征：</strong>
            <span>{route.stability}</span>
          </div>

          <ul>
            {route.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Regions & Protocol Box -->
    <div class="regions-banner bento-reveal delay-4">
      <div class="regions-header">
        <div>
          <h4>已核查历史覆盖国家与地区</h4>
          <p class="text-xs text-muted">基于公开档案记录，实际开通节点列表以客户端订阅拉取结果为准</p>
        </div>
        <span class="badge badge-green">8 大核心地区</span>
      </div>

      <div class="regions-tags">
        {regionNodes.map((node) => (
          <div class="region-pill">
            <span class="region-flag">{node.flag}</span>
            <span class="region-name">{node.name}</span>
          </div>
        ))}
      </div>

      <div class="protocol-box">
        <div class="protocol-header">
          <strong>协议要求：{protocolInfo.name}</strong>
          <span class="text-xs text-muted">{protocolInfo.updateHistory}</span>
        </div>
        <ul class="protocol-points">
          {protocolInfo.keyRequirements.map((req) => (
            <li>{req}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .text-xs { font-size: 0.75rem; }
  .text-muted { color: var(--color-secondary-text); }

  .route-principle {
    font-size: 0.92rem;
    margin: 12px 0 16px 0;
    line-height: 1.6;
    color: var(--color-primary-text);
  }

  .scenario-box, .stability-box {
    background-color: var(--color-surface-muted);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    font-size: 0.85rem;
    margin-bottom: 10px;
    line-height: 1.5;
  }

  .scenario-box strong, .stability-box strong {
    color: var(--color-deep-blue);
  }

  .regions-banner {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 34px;
    margin-top: 36px;
  }

  .regions-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .regions-header h4 {
    font-size: 1.2rem;
    color: var(--color-deep-blue);
  }

  .regions-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .region-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .region-flag {
    font-size: 1.2rem;
  }

  .protocol-box {
    background-color: #F8FAFC;
    border-left: 3px solid var(--color-button-blue);
    padding: 16px 20px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .protocol-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 0.95rem;
    color: var(--color-deep-blue);
  }

  .protocol-points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .protocol-points li {
    font-size: 0.88rem;
    color: var(--color-secondary-text);
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .protocol-points li::before {
    content: "•";
    color: var(--color-button-blue);
    font-weight: bold;
  }
</style>
