---
import { getCollection } from 'astro:content';

interface Props {
  showSearch?: boolean;
}

const { showSearch = false } = Astro.props;
const articles = await getCollection('articles');

// Sort by publishDate descending
const sortedArticles = articles.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<section id="guides" class="articles-section">
  <div class="container">
    <div class="section-header bento-reveal">
      <span class="badge badge-ice section-tag">原创技术智库</span>
      <h2>CTC 原创网络排错与连接指南</h2>
      <p>拒绝空洞营销套话，针对具体设备、局域网架构与协议特性，提供详实的操作验证流程。</p>
    </div>

    {showSearch && (
      <div class="search-bar-wrapper bento-reveal mb-6">
        <div class="search-input-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            id="article-search-input" 
            placeholder="搜索指南关键词（如：Windows、WiFi、安卓、iOS、校园网、自检）..." 
            aria-label="搜索指南"
          />
          <button type="button" id="article-search-clear" style="display: none;">清空</button>
        </div>
        <div class="search-meta">
          <span id="article-search-count" style="display: none;"></span>
        </div>
      </div>
    )}

    <div class="articles-grid">
      {sortedArticles.map((article, index) => (
        <article 
          class={`article-card bento-reveal delay-${(index % 3) + 1}`}
          data-article-card
          data-title={article.data.title}
          data-desc={article.data.description}
          data-tags={article.data.keywords.join(',')}
        >
          <div>
            <div class="article-card-meta">
              <span class="badge badge-ice">{article.data.category}</span>
              <span>•</span>
              <time datetime={article.data.publishDate}>{article.data.publishDate}</time>
              <span>•</span>
              <span>{article.data.readTime}</span>
            </div>

            <h3>
              <a href={`/guides/${article.id}/`}>
                {article.data.title}
              </a>
            </h3>

            <p>{article.data.description}</p>
          </div>

          <div class="article-footer">
            <div class="tags-row">
              {article.data.keywords.slice(0, 2).map((kw) => (
                <span class="kw-tag">#{kw}</span>
              ))}
            </div>
            <a href={`/guides/${article.id}/`} class="read-more-link">
              阅读全文 →
            </a>
          </div>
        </article>
      ))}
    </div>

    <div id="article-search-empty" class="empty-state" style="display: none;">
      <p>未找到匹配的指南内容，请尝试更换其他关键词，或前往 <a href="/diagnostics/">网络自检中心</a> 进行规则排查。</p>
    </div>
  </div>
</section>

{showSearch && (
  <script>
    import { initArticleSearch } from '../scripts/article-search';
    initArticleSearch();
  </script>
)}

<style>
  .mb-6 { margin-bottom: 30px; }

  .search-bar-wrapper {
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .search-input-box {
    display: flex;
    align-items: center;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 8px 20px;
    box-shadow: var(--shadow-sm);
  }

  .search-icon {
    color: var(--color-secondary-text);
    margin-right: 10px;
  }

  #article-search-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 0.95rem;
    color: var(--color-primary-text);
    background: transparent;
  }

  #article-search-clear {
    background: none;
    border: none;
    color: var(--color-secondary-text);
    cursor: pointer;
    font-size: 0.85rem;
  }

  .search-meta {
    text-align: center;
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--color-button-blue);
    font-weight: 600;
  }

  .article-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tags-row {
    display: flex;
    gap: 8px;
  }

  .kw-tag {
    font-size: 0.75rem;
    color: var(--color-secondary-text);
  }

  .read-more-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-button-blue);
  }

  .empty-state {
    text-align: center;
    padding: 50px 20px;
    background-color: #FFFFFF;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    margin-top: 30px;
  }
</style>
